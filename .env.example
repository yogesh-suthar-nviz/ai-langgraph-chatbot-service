# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database & Redis (Optional locally: in-memory fallbacks automatically engage if not connected)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/chatbot_db
REDIS_URL=redis://localhost:6379

# LLM Configuration
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Authentication & Identity Modes
AUTH_MODE=mock
INTERNAL_SSO_ENABLED=false
EXTERNAL_SSO_ENABLED=false

# OIDC Provider Configuration (for production enterprise SSO)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
